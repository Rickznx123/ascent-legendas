{
  "name": "legendas-dinamicas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "gerar": "tsx src/cli.ts",
    "conferir": "tsx src/cli.ts --conferir",
    "typecheck": "tsc --noEmit",
    "app": "tsx app/servidor/index.ts",
    "app:rede": "tsx app/servidor/index.ts --rede",
    "app:montar": "vite build --config app/web/vite.config.ts",
    "app:producao": "tsx app/servidor/index.ts --producao",
    "medir-sincronia": "tsx medicao/medir-sincronia.ts",
    "link-login": "tsx scripts/link-login.ts",
    "nuvem:site": "tsx nuvem/site.ts",
    "landing:estilos": "tsx scripts/landing-estilos.ts",
    "plano": "tsx scripts/plano.ts",
    "teste:assinaturas": "tsx --test app/servidor/assinaturas.teste.ts app/servidor/pix.teste.ts app/servidor/planos.teste.ts app/servidor/pagamento-aprovado.teste.ts",
    "app:publico": "tsx app/servidor/index.ts --producao"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.986.0",
    "@aws-sdk/s3-request-presigner": "^3.986.0",
    "@remotion/bundler": "4.0.532",
    "@remotion/install-whisper-cpp": "4.0.532",
    "@remotion/layout-utils": "4.0.532",
    "@remotion/player": "^4.0.532",
    "@remotion/renderer": "4.0.532",
    "@supabase/supabase-js": "^2.117.2",
    "@vitejs/plugin-react": "^4.7.0",
    "express": "^4.22.3",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "remotion": "4.0.532",
    "vite": "^6.4.3"
  },
  "devDependencies": {
    "@remotion/lambda": "4.0.532",
    "@types/express": "^4.17.25",
    "@types/node": "^24.0.0",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "qrcode-terminal": "^0.12.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
