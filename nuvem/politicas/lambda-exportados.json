{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LambdaGravaOsExportados",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": [
        "arn:aws:s3:::ascent-legendas-videos-275060989338/exportados/*"
      ]
    },
    {
      "Sid": "LambdaVeOsExportados",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::ascent-legendas-videos-275060989338",
      "Condition": {
        "StringLike": {
          "s3:prefix": "exportados/*"
        }
      }
    }
  ]
}
