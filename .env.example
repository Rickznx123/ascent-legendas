# Copie este arquivo para .env e preencha. O .env nunca vai para o git.
# As chaves de transcrição valem no npm run app, no npm run gerar e em nuvem/;
# as da AWS só em nuvem/.

# Usuário IAM "remotion-user" (chave de acesso criada no console da AWS)
REMOTION_AWS_ACCESS_KEY_ID=
REMOTION_AWS_SECRET_ACCESS_KEY=
# Região da função e do bucket
REMOTION_AWS_REGION=us-east-1

# Transcrição padrão: WhisperX no Replicate (replicate.com > Account > API tokens).
# Sem ela, ou se o Replicate falhar ou passar de 60 s, a transcrição usa a Groq.
REPLICATE_API_TOKEN=
# Chave da API da Groq (console.groq.com > API Keys): a reserva do WhisperX.
# Sem nenhuma das duas, ou sem internet, a transcrição usa o Whisper local.
GROQ_API_KEY=
# local: transcreve sempre com o Whisper local (sem internet), sem tentar as APIs.
# TRANSCRICAO=local
