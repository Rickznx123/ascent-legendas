# Copie este arquivo para .env e preencha. O .env nunca vai para o git.
# As chaves de transcrição valem no npm run app, no npm run gerar e em nuvem/;
# as da AWS só em nuvem/.

# Usuário IAM "remotion-user" (chave de acesso criada no console da AWS)
REMOTION_AWS_ACCESS_KEY_ID=
REMOTION_AWS_SECRET_ACCESS_KEY=
# Região da função e do bucket
REMOTION_AWS_REGION=us-east-1

# Transcrição padrão: WhisperX no Replicate (replicate.com > Account > API tokens).
# Sem ela, ou se o Replicate falhar ou passar de 60 s, a transcrição usa a Groq.
REPLICATE_API_TOKEN=
# Chave da API da Groq (console.groq.com > API Keys): a reserva do WhisperX.
# Sem nenhuma das duas, ou sem internet, a transcrição usa o Whisper local.
GROQ_API_KEY=
# local: transcreve sempre com o Whisper local (sem internet), sem tentar as APIs.
# TRANSCRICAO=local

# Login e projetos por usuário (Supabase > Project Settings > API Keys). Sem elas, o
# app roda no modo local, sem login. A chave secreta só é usada no servidor.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# 1: mostra "Entrar com Google" (depois de configurar o Google no Supabase).
# LOGIN_GOOGLE=1

# Servidor na internet (Render). No painel do Render, não neste arquivo:
# SERVIDOR_PUBLICO=1        (a imagem já define; pode repetir no painel)
# ENDERECO_DO_APP=https://legendas.ascentstudio.com.br
# BUCKET_DOS_VIDEOS=ascent-legendas-videos-275060989338
# REMOTION_AWS_REGION=us-east-2
# PORT                      o Render define sozinho; não criar.
# Opcionais: FILA_RENDERS e FILA_TRANSCRICOES (vagas da fila; padrão 20 e 3),
# LOGIN_GOOGLE=1. Não usar no Render: TRANSCRICAO, FFMPEG_PATH, FFPROBE_PATH, PORTA.
# Assinatura pelo Mercado Pago (Etapa 2c). Sem o token, não há "Assinar".
# MERCADOPAGO_ACCESS_TOKEN=     (Suas integrações → aplicação → Credenciais; de teste ou de produção)
# MERCADOPAGO_WEBHOOK_SECRET=   (Suas integrações → aplicação → Webhooks → assinatura secreta)
# ASSINATURA_VALOR_BRL=30       (opcional; padrão 30; vale para o cartão por mês e o Pix de 30 dias)
# CHAVE_ADMIN=                  (opcional; liga /admin/assinatura/:id para diagnóstico. Só uma
#                                chave própria, com 32+ caracteres: nunca a do Supabase)
# Só no computador, para nuvem/criar-bucket.ts: ENDERECOS_EXTRAS (outros endereços
# liberados no CORS do bucket, separados por vírgula).
# Pixel da Meta e API de Conversões (medir anúncios; veja app/servidor/meta.ts).
# Sem META_PIXEL_ID, o Pixel não carrega; sem META_CAPI_TOKEN, o servidor não envia eventos.
# META_PIXEL_ID=
# META_CAPI_TOKEN=
# META_TEST_EVENT_CODE=         (opcional, só para testar: o código TEST... de "Testar eventos")
