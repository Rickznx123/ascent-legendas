{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "vite/client"
    ]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "templates/**/*.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "nuvem/**/*.ts",
    "medicao/**/*.ts"
  ],
  "exclude": [
    "app/web/dist"
  ]
}
